-- [ ฟังก์ชันระบบหลังบ้าน (Core Logic) ] --
local function recordEgg(eggName)
    if not Framework.EggLog.Counts[eggName] then Framework.EggLog.Counts[eggName] = 0 end
    Framework.EggLog.Counts[eggName] = Framework.EggLog.Counts[eggName] + 1
    Framework.EggLog.TotalPicked = Framework.EggLog.TotalPicked + 1
end

local function sendDiscordLog()
    if DISCORD_WEBHOOK_URL == "" or DISCORD_WEBHOOK_URL == "วาง_WEBHOOK_URL_ตรงนี้" then return end
    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
    if not requestFunc then return end

    local eggDetailsText = ""
    for eggName, count in pairs(Framework.EggLog.Counts) do
        eggDetailsText = eggDetailsText .. "• **" .. eggName .. "**: " .. count .. " ฟอง\n"
    end
    if eggDetailsText == "" then eggDetailsText = "ยังไม่มีข้อมูลการเก็บไข่ในรอบนี้" end

    local embed = {
        title = "🍄 MushroomHub | รายงานการเก็บไข่",
        color = 10181046, -- Purple/Pinkish
        fields = {
            { name = "👤 บัญชี", value = "`" .. LocalPlayer.Name .. "`", inline = true },
            { name = "📊 เก็บได้รวม", value = "`" .. Framework.EggLog.TotalPicked .. " ฟอง`", inline = true },
            { name = "📋 รายละเอียด", value = eggDetailsText, inline = false }
        },
        footer = { text = "MushroomHub Auto Sniper" },
        timestamp = DateTime.now():ToIsoDate()
    }
    pcall(function()
        requestFunc({ Url = DISCORD_WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ embeds = { embed } }) })
    end)
end

function Framework:StartAll()
    if self.IsRunning then return end
    self.IsRunning = true
end

function Framework:StopAll()
    self.IsRunning = false
    self.IsLooping = false
    if self.ScreenGui then self.ScreenGui:Destroy(); self.ScreenGui = nil end
end

local function safeTweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local rootPart = char.HumanoidRootPart
    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
    if distance < 2 then return true end
    local duration = distance / Framework.TweenSpeed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function findEggInRenderedEggs(targetName)
    local renderedFolder = nil
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == "RenderedEggs" and desc:IsA("Folder") then
            renderedFolder = desc
            break
        end
    end
    if not renderedFolder then return nil, nil end
    for _, obj in ipairs(renderedFolder:GetChildren()) do
        if obj.Name == targetName then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return obj, part end
        end
    end
    return nil, nil
end

local function getMyPlotPosition()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == "Plot" and desc:IsA("Model") then
            local ownerLoaded = desc:GetAttribute("NestsOwnerLoaded")
            if ownerLoaded and (tostring(ownerLoaded) == tostring(LocalPlayer.UserId) or tostring(ownerLoaded) == tostring(LocalPlayer.Name)) then
                local part = desc:FindFirstChildWhichIsA("BasePart", true)
                if part then return part.CFrame + Vector3.new(0, 5, 0) end
            end
            local dataFolder = desc:FindFirstChild("Data")
            if dataFolder then
                local ownerVal = dataFolder:FindFirstChild("Owner")
                if ownerVal and (ownerVal.Value == LocalPlayer.Name or ownerVal.Value == LocalPlayer or tostring(ownerVal.Value) == tostring(LocalPlayer.UserId)) then
                    local part = desc:FindFirstChildWhichIsA("BasePart", true)
                    if part then return part.CFrame + Vector3.new(0, 5, 0) end
                end
            end
        end
    end
    return nil
end

local function triggerPickUp(eggInstance, eggPart)
    pcall(function()
        local char = LocalPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local hasPrompt = false
        for _, desc in ipairs(eggInstance:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then hasPrompt = true; fireproximityprompt(desc, 0)
            elseif desc:IsA("ClickDetector") then hasPrompt = true; fireclickdetector(desc) end
        end
        if not hasPrompt and rootPart and eggPart then
            firetouchinterest(rootPart, eggPart, 0); task.wait(0.05); firetouchinterest(rootPart, eggPart, 1)
        end
    end)
end

-- [ ระบบ UI หรูหรากะทัดรัด ] --
local function addCorner(obj, radius)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, radius or 6); c.Parent = obj
end

-- เอฟเฟกต์ดาววิ้งๆ
local function createSparkleEffect(parentFrame)
    task.spawn(function()
        while task.wait(math.random(3, 8) / 10) do
            if not parentFrame or not parentFrame.Parent then break end
            local star = Instance.new("TextLabel")
            star.Text = "✨"
            star.BackgroundTransparency = 1
            star.TextSize = math.random(10, 18)
            star.Position = UDim2.new(math.random(5, 95)/100, 0, math.random(5, 95)/100, 0)
            star.ZIndex = 0
            star.Parent = parentFrame
            
            local tw1 = TweenService:Create(star, TweenInfo.new(1), {TextTransparency = 0.8, Position = star.Position - UDim2.new(0,0,0.05,0)})
            tw1:Play()
            tw1.Completed:Connect(function() star:Destroy() end)
        end
    end)
end

