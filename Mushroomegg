    local function updateStatus()
        local count = 0
        for _, s in pairs(Framework.SelectedEggs) do if s then count = count + 1 end end
        statusLbl.Text = "Selected: " .. count .. " | Picked: " .. Framework.EggLog.TotalPicked
    end

    local function scanEggs()
        for _, child in ipairs(scrollContainer:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local eggNames = {}
        for _, service in ipairs({ ReplicatedStorage, Workspace, Lighting }) do
            pcall(function()
                for _, desc in ipairs(service:GetDescendants()) do
                    if (desc.Name == "Eggs" or desc.Name == "Egg") and (desc:IsA("Folder") or desc:IsA("Model")) then
                        for _, egg in ipairs(desc:GetChildren()) do
                            if egg.Name and egg.Name ~= "" then eggNames[egg.Name] = true end
                        end
                    end
                end
            end)
        end

        local sortedNames = {}
        for name in pairs(eggNames) do table.insert(sortedNames, name) end
        table.sort(sortedNames)

        for _, name in ipairs(sortedNames) do
            local eggBtn = Instance.new("TextButton")
            eggBtn.Size = UDim2.new(1, 0, 0, 24)
            local isSelected = Framework.SelectedEggs[name] or false
            eggBtn.BackgroundColor3 = isSelected and Color3.fromRGB(120, 50, 150) or Color3.fromRGB(30, 20, 35)
            eggBtn.Text = (isSelected and " ✨ " or " ◦ ") .. name
            eggBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
            eggBtn.TextSize, eggBtn.Font = 10, Enum.Font.GothamMedium
            addCorner(eggBtn, 4)
            eggBtn.Parent = scrollContainer

            eggBtn.MouseButton1Click:Connect(function()
                Framework.SelectedEggs[name] = not Framework.SelectedEggs[name]
                local active = Framework.SelectedEggs[name]
                eggBtn.BackgroundColor3 = active and Color3.fromRGB(120, 50, 150) or Color3.fromRGB(30, 20, 35)
                eggBtn.Text = (active and " ✨ " or " ◦ ") .. name
                updateStatus()
            end)
        end
        updateStatus()
        scrollContainer.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
    end

    selectAllBtn.MouseButton1Click:Connect(function()
        for _, btn in ipairs(scrollContainer:GetChildren()) do
            if btn:IsA("TextButton") then
                local eggName = btn.Text:sub(5)
                Framework.SelectedEggs[eggName] = true
                btn.BackgroundColor3 = Color3.fromRGB(120, 50, 150)
                btn.Text = " ✨ " .. eggName
            end
        end
        updateStatus()
    end)

    clearAllBtn.MouseButton1Click:Connect(function()
        Framework.SelectedEggs = {}
        for _, btn in ipairs(scrollContainer:GetChildren()) do
            if btn:IsA("TextButton") then
                local eggName = btn.Text:sub(5)
                btn.BackgroundColor3 = Color3.fromRGB(30, 20, 35)
                btn.Text = " ◦ " .. eggName
            end
        end
        updateStatus()
    end)

    refreshBtn.MouseButton1Click:Connect(scanEggs)
    task.spawn(scanEggs)

    -- ปุ่ม Auto Loop (เริ่มฟาร์ม)
    local toggleLoopBtn = Instance.new("TextButton")
    toggleLoopBtn.Size = UDim2.new(0.9, 0, 0, 28)
    toggleLoopBtn.Position = UDim2.new(0.05, 0, 0.73, 0)
    toggleLoopBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 100)
    toggleLoopBtn.Text = "▶ Start Auto Farm"
    toggleLoopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleLoopBtn.TextSize, toggleLoopBtn.Font = 11, Enum.Font.GothamBold
    addCorner(toggleLoopBtn, 6)
    toggleLoopBtn.Parent = mainFrame

    toggleLoopBtn.MouseButton1Click:Connect(function()
        Framework.IsLooping = not Framework.IsLooping
        if Framework.IsLooping then
            toggleLoopBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 50)
            toggleLoopBtn.Text = "⏹ Stop Farming"
        else
            toggleLoopBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 100)
            toggleLoopBtn.Text = "▶ Start Auto Farm"
        end
    end)

    -- ปุ่ม Discord
    local sendLogBtn = Instance.new("TextButton")
    sendLogBtn.Size = UDim2.new(0.9, 0, 0, 24)
    sendLogBtn.Position = UDim2.new(0.05, 0, 0.82, 0)
    sendLogBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    sendLogBtn.Text = "📩 Send Discord Log"
    sendLogBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    sendLogBtn.TextSize, sendLogBtn.Font = 10, Enum.Font.GothamMedium
    addCorner(sendLogBtn, 6)
    sendLogBtn.Parent = mainFrame
    sendLogBtn.MouseButton1Click:Connect(sendDiscordLog)

    -- ปุ่ม Emergency Stop
    local emergencyBtn = Instance.new("TextButton")
    emergencyBtn.Size = UDim2.new(0.9, 0, 0, 22)
    emergencyBtn.Position = UDim2.new(0.05, 0, 0.90, 0)
    emergencyBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 60)
    emergencyBtn.Text = "✖ Close Hub"
    emergencyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    emergencyBtn.TextSize, emergencyBtn.Font = 10, Enum.Font.GothamMedium
    addCorner(emergencyBtn, 6)
    emergencyBtn.Parent = mainFrame
    emergencyBtn.MouseButton1Click:Connect(function() self:StopAll() end)

    -- ลูปฟาร์มไข่
    task.spawn(function()
        while true do
            task.wait(0.5)
            if Framework.IsLooping then
                pcall(function()
                    local activeList = {}
                    for eggName, selected in pairs(Framework.SelectedEggs) do
                        if selected then table.insert(activeList, eggName) end
                    end
                    table.sort(activeList)

                    if #activeList == 0 then return end

                    for _, eggName in ipairs(activeList) do
                        if not Framework.IsLooping then break end

                        local targetEggInstance, eggPart = findEggInRenderedEggs(eggName)
                        if targetEggInstance and eggPart then
                            local reached = safeTweenTo(eggPart.CFrame + Vector3.new(0, 3, 0))
                            if reached and Framework.IsLooping then
                                local startTime = tick()
                                while tick() - startTime < 1.5 and Framework.IsLooping do
                                    triggerPickUp(targetEggInstance, eggPart)
                                    task.wait(0.2)
                                end
                                recordEgg(eggName)
                                updateStatus()
                                local plotPos = getMyPlotPosition()
                                if plotPos then safeTweenTo(plotPos) end
                                task.wait(0.3)
                            end
                        end
                    end
                end)
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(300)
            if Framework.EggLog.TotalPicked > 0 then sendDiscordLog() end
        end
    end)
end

