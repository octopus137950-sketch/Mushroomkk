local DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/1553723214872453140/dHkbaMfJ71QuJc51EQ5txQ31-nS0HXjX7kUaI_O6bKfxa_pY8YHop5pljOM3_J9nYBe-"

